#!/bin/sh
set -eu

APP_BINARY="/Applications/SidePulse.app/Contents/MacOS/SidePulse"
CLI_DIR="/usr/local/bin"
CLI_LINK="$CLI_DIR/sidepulse"
RECEIPT_DIR="/var/db/sidepulse"
PENDING_RECEIPT="$RECEIPT_DIR/setup-pending"
COMPLETE_RECEIPT="$RECEIPT_DIR/setup-complete"
LAUNCH_AGENT_NAME="io.sidepulse.agentstatus.plist"

log() {
    /bin/echo "SidePulse postinstall: $*"
}

fail() {
    /bin/echo "SidePulse postinstall: $*" >&2
    exit 1
}

if [ ! -x "$APP_BINARY" ]; then
    fail "installed application executable is missing or not executable"
fi

/bin/mkdir -p "$CLI_DIR" "$RECEIPT_DIR"
/bin/chmod 755 "$CLI_DIR" "$RECEIPT_DIR"

# Never replace an unrelated user-managed command. We own the link only when
# it is absent or already points at the packaged SidePulse executable.
if [ ! -e "$CLI_LINK" ] && [ ! -L "$CLI_LINK" ]; then
    /bin/ln -s "$APP_BINARY" "$CLI_LINK"
elif [ -L "$CLI_LINK" ] && [ "$(/usr/bin/readlink "$CLI_LINK")" = "$APP_BINARY" ]; then
    /bin/ln -sfn "$APP_BINARY" "$CLI_LINK"
else
    log "left existing $CLI_LINK unchanged because SidePulse does not own it"
fi

# A package install owns only package payload. Provider hooks, LaunchAgents,
# the sleep helper, and the eject guard are external mutable state and require
# an explicit user action. Running those changes from postinstall made a later
# failure impossible to roll back safely without removing pre-existing setup.
CONSOLE_USER="$(/usr/bin/stat -f '%Su' /dev/console)"
CONSOLE_HOME=""
if [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ] && [ "$CONSOLE_USER" != "loginwindow" ]; then
    CONSOLE_HOME="$(/usr/bin/dscl . -read "/Users/$CONSOLE_USER" NFSHomeDirectory 2>/dev/null | /usr/bin/awk '{print $2}')"
fi

if [ -n "$CONSOLE_HOME" ] && [ -f "$CONSOLE_HOME/Library/LaunchAgents/$LAUNCH_AGENT_NAME" ]; then
    /bin/date -u '+%Y-%m-%dT%H:%M:%SZ' > "$COMPLETE_RECEIPT"
    /bin/chmod 644 "$COMPLETE_RECEIPT"
    /bin/rm -f "$PENDING_RECEIPT"
    log "application upgraded; existing explicit SidePulse setup remains in place"
else
    /bin/date -u '+%Y-%m-%dT%H:%M:%SZ' > "$PENDING_RECEIPT"
    /bin/chmod 644 "$PENDING_RECEIPT"
    /bin/rm -f "$COMPLETE_RECEIPT"
    log "application installed; open SidePulse and complete the reviewed first-run setup"
fi

exit 0
